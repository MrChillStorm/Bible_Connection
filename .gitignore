.venv/
__pycache__/
*.pyc
.DS_Store
# Claude Code's own browser-preview tooling config -- not part of the project
.claude/
# pip / pipx build output
build/
dist/
*.egg-info/
# bible.db (~190MB) is never in the repo: bible_connection/data/bible.db.zip
# (~82MB) is what's committed, and the app extracts it into the per-user
# data folder on first launch (see bible_connection/core/db_bootstrap.py).
# data/processed/ is where it (and user_state.db) lived before 1.0.
data/processed/
bible_connection/data/*.tmp
data/raw/cross-references.zip
# STEPBible-Data's CC BY 4.0 terms ask that this be redistributed only
# from their own GitHub repo, not copied elsewhere -- re-download with
# fetch_strongs_lexicon.py rather than committing a local copy.
data/raw/tbesg.txt
data/raw/tbesh.txt
# intermediate build output -- packaging/build_icon.py regenerates this
packaging/AppIcon.iconset/
